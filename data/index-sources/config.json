{
  "schema_version": 1,
  "limits": {
    "max_records": 300,
    "max_new_per_run": 25,
    "max_updated_fraction": 0.5,
    "max_response_bytes": 3000000,
    "min_request_interval_seconds": 1,
    "timeout_seconds": 12,
    "retries": 1,
    "max_link_checks": 24,
    "max_index_bytes": 600000
